# Speech (Piper local TTS)
TURTLE_LANGUAGE="fr"
TTS_ENABLED=True
TTS_PIPER_COMMAND="piper"
TTS_VOICES={"fr":"models/voices/fr_FR-siwis-medium.onnx","en":"models/voices/en_US-lessac-medium.onnx"}
TTS_MAX_CHARS=500
TTS_TIMEOUT=90

# Runtime
DEBUG=True
SIMULATION=False
API_HOST="0.0.0.0"
API_PORT=8000
UPDATE_RATE=50
HEARTBEAT_INTERVAL=30
HEALTH_INTERVAL=60
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_ROTATION=180 # Allowed: 0, 90, 180, 270
FACE_FPS=20
SHELL_FPS=15

# Optional live face recognition (disabled on startup)
FACE_RECOGNITION_ENABLED=True
FACE_RECOGNITION_INTERVAL=2.0
FACE_RECOGNITION_WIDTH=320
FACE_RECOGNITION_THRESHOLD=0.45

# Bluetooth LE control fallback
BLUETOOTH_ENABLED=True
BLUETOOTH_NAME="SpyTurtle"
BLUETOOTH_SERVICE_UUID="6f2d0001-9b7e-4b2a-a1d3-53d9c4e8f210"
BLUETOOTH_COMMAND_UUID="6f2d0002-9b7e-4b2a-a1d3-53d9c4e8f210"
BLUETOOTH_STATE_UUID="6f2d0003-9b7e-4b2a-a1d3-53d9c4e8f210"
BLUETOOTH_ADMIN_UUID="6f2d0004-9b7e-4b2a-a1d3-53d9c4e8f210"
BLUETOOTH_CAMERA_UUID="6f2d0005-9b7e-4b2a-a1d3-53d9c4e8f210"
BLUETOOTH_VISION_ENABLED=True
BLUETOOTH_VISION_CHUNK=240 # Reduce to 15 if notifications exceed negotiated MTU.
BLUETOOTH_VISION_INTERVAL=0.001 # Seconds between notifications; increase if frames are incomplete.
BLUETOOTH_VISION_WIDTH=640 # V5 baseline
BLUETOOTH_VISION_HEIGHT=360 # V5 baseline
BLUETOOTH_VISION_QUALITY=25 # V5 baseline

# Shared buses
I2C_SDA_PIN=2
I2C_SCL_PIN=3
SPI_SCLK_PIN=11
SPI_MOSI_PIN=10
SPI_MISO_PIN=9
SPI_CE0_PIN=8

# OLED eyes (shared I2C bus)
EYES_ENABLED=True
OLED_LEFT_ADDRESS=0x3C
OLED_RIGHT_ADDRESS=0x3D

# VL53L0X/VL53L1X ToF distance sensor (shared I2C bus)
DISTANCE_SENSOR_ENABLED=True
DISTANCE_SENSOR_ADDRESS=0x29
DISTANCE_SENSOR_UPDATE_INTERVAL=0.25
DISTANCE_SENSOR_MAX_MM=2000

# BME680 environmental sensor (shared I2C bus)
BME680_ENABLED=True
BME680_ADDRESS=0x77
BME680_UPDATE_INTERVAL=5.0
BME680_AIR_QUALITY_POINTS=((0,10000),(2,20000),(5,50000),(8,100000),(10,200000))

# MLX90640 thermal camera (shared I2C bus)
THERMAL_CAMERA_ENABLED=True
THERMAL_CAMERA_ADDRESS=0x33
THERMAL_I2C_FREQUENCY=400000
THERMAL_REFRESH_RATE_HZ=2
THERMAL_OUTPUT_WIDTH=320
THERMAL_OUTPUT_HEIGHT=240
THERMAL_ROTATION=90 # Allowed: 0, 90, 180, 270
THERMAL_FLIP_VERTICAL=True
THERMAL_JPEG_QUALITY=88

# USB microphone
MICROPHONE_ENABLED=True
MICROPHONE_DEVICE="plughw:CARD=Device,DEV=0"
MICROPHONE_RATE=16000
MICROPHONE_CHANNELS=1

# Shell ST7796 display
SHELL_DISPLAY_SPI_BUS=0
SHELL_DISPLAY_SPI_DEVICE=0
SHELL_DISPLAY_DC_PIN=25
SHELL_DISPLAY_RESET_PIN=24
SHELL_DISPLAY_SPI_SPEED_HZ=16000000

# Camera servos
SERVO_PAN_PIN=17
SERVO_TILT_PIN=27

# WS2812B shell LEDs
LED_DATA_PIN=4

# MAX98357A I2S audio
AUDIO_BCLK_PIN=18
AUDIO_LRCLK_PIN=19
AUDIO_DATA_PIN=21

# TB6612FNG motor driver
MOTOR_STBY_PIN=5
MOTOR_PWMA_PIN=12
MOTOR_AIN1_PIN=6
MOTOR_AIN2_PIN=13
MOTOR_PWMB_PIN=26
MOTOR_BIN1_PIN=16
MOTOR_BIN2_PIN=20
MOTOR_PWM_FREQUENCY=1000

# Motor orientation and tuning
MOTOR_LEFT_INVERTED=True
MOTOR_RIGHT_INVERTED=False
MOTOR_DRIVE_SPEED=0.30
MOTOR_TURN_SPEED=0.25
MOTOR_SPEED_STEP=0.05
MOTOR_MIN_SPEED=0.20
MOTOR_MAX_SPEED=1.00

# Optional single-channel motor encoders
# Encoder wiring validated on GPIO 14/15 using pull-up inputs.
MOTOR_ENCODERS_ENABLED=True
MOTOR_LEFT_ENCODER_A_PIN=14
MOTOR_LEFT_ENCODER_B_PIN=None
MOTOR_RIGHT_ENCODER_A_PIN=15
MOTOR_RIGHT_ENCODER_B_PIN=None
MOTOR_LEFT_ENCODER_INVERTED=False
MOTOR_RIGHT_ENCODER_INVERTED=False
MOTOR_ENCODER_PULL_UP=True
MOTOR_ENCODER_PULSES_PER_REV=0

# Closed-loop left/right wheel-speed balancing
# Requires MOTOR_ENCODERS_ENABLED=True. Applies only to forward/backward; turns remain open-loop.
MOTOR_ENCODER_CORRECTION_ENABLED=True
MOTOR_ENCODER_CORRECTION_INTERVAL=0.10
MOTOR_ENCODER_CORRECTION_KP=0.30
MOTOR_ENCODER_CORRECTION_MAX=0.12
MOTOR_ENCODER_CORRECTION_MIN_PULSES=2
MOTOR_ENCODER_CORRECTION_LOG_INTERVAL=0.1

# Mechanical geometry / future encoder calibration
MOTOR_WHEEL_DIAMETER_MM=65.0
MOTOR_TRACK_WIDTH_MM=180.0
MOTOR_DISTANCE_STEP_MM=3.33
MOTOR_TURN_STEP_DEGREES=3.33

# ST7796 capacitive touch GPIO reservation
# Wiring is reserved now; runtime touch support remains disabled until the
# controller model/address is detected and the driver is implemented.
ST7796_CTP_ENABLED=True
ST7796_CTP_I2C_BUS=1
ST7796_CTP_INT_GPIO=22
ST7796_CTP_RST_GPIO=23
ST7796_CTP_WIDTH=320
ST7796_CTP_HEIGHT=480
ST7796_CTP_SWAP_XY=False
ST7796_CTP_INVERT_X=False
ST7796_CTP_INVERT_Y=False

# V5: keep 60 for known-good BLE notifications. Try 80/100/120 only if phone receives complete images.


# Maximum absolute motor PWM at full joystick deflection (0..1)
MOTOR_JOYSTICK_MAX_SPEED=MOTOR_DRIVE_SPEED*1.25

# Local Ollama conversation
CHAT_OLLAMA_URL="http://127.0.0.1:11434"
CHAT_MODEL="qwen2.5:1.5b"
CHAT_KEEP_LOADED=True # Preload Ollama and keep model in memory; False restores default expiry
CHAT_MAX_TOKENS=80
CHAT_TEMPERATURE=0.7
CHAT_CONTEXT_SIZE=2048
CHAT_TIMEOUT=120
CHAT_MAX_INPUT_CHARS=500
CHAT_HISTORY_MESSAGES=8
CHAT_STATIC_PROMPT_PRELOAD=True # Warm the stable system prefix on startup; requires CHAT_KEEP_LOADED
CHAT_MOOD_CONTEXT_ENABLED=False # False: send only current mood; True: include imaginary mood context
