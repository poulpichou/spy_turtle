#!/usr/bin/env python3
"""Root-only narrow helper: register the Pi's current private LAN IPv4 in Caddy."""
import ipaddress,os,re,subprocess,sys,tempfile
from pathlib import Path
CONFIG=Path('/etc/caddy/Caddyfile')
def run(args):
    env=os.environ.copy()
    config=Path('/etc/default/spy-turtle-caddy')
    if config.exists():
        match=re.search(r'^SPY_LOCAL_IP=(\d+\.\d+\.\d+\.\d+)$',config.read_text(),re.M)
        if match:env['SPY_LOCAL_IP']=match.group(1)
    return subprocess.run(args,capture_output=True,text=True,check=True,timeout=8,env=env).stdout.strip()
def main():
    # Default route chooses current LAN IPv4; never trust an IP provided by a browser or BLE client.
    route=run(['ip','-4','route','get','1.1.1.1'])
    match=re.search(r'\bsrc (\d+\.\d+\.\d+\.\d+)\b',route)
    if not match:raise RuntimeError('No active LAN IPv4')
    ip=match.group(1)
    if not ipaddress.ip_address(ip).is_private:raise RuntimeError('LAN IPv4 must be private')
    original=CONFIG.read_text()
    # Operate only on the known Spy Turtle site, preserving its bind and TLS configuration.
    lines=original.splitlines(keepends=True)
    indices=[i for i,line in enumerate(lines) if line.startswith('spyturtle.local,') and line.rstrip().endswith('{')]
    if len(indices)!=1:raise RuntimeError('Expected one Spy Turtle Caddy site block')
    index=indices[0];labels=[item.strip() for item in lines[index].split('{',1)[0].split(',')]
    if 'spyturtle.local' not in labels:raise RuntimeError('Unexpected Caddy site')
    label='https://'+ip
    if label in labels:print('Already configured: '+label);return
    labels.append(label);lines[index]=', '.join(labels)+' {\n'
    updated=''.join(lines)
    backup=CONFIG.with_name('Caddyfile.before_manual_https')
    backup.write_text(original)
    temp=CONFIG.with_name('Caddyfile.manual_https.tmp')
    temp.write_text(updated)
    try:
        run(['caddy','validate','--config',str(temp),'--adapter','caddyfile'])
        os.replace(temp,CONFIG)
        try:run(['systemctl','reload','caddy'])
        except Exception:
            CONFIG.write_text(original)
            run(['systemctl','reload','caddy'])
            raise
    finally:temp.unlink(missing_ok=True)
    print('Added '+label+'; Caddy reloaded. Open '+label)
if __name__=='__main__':
    try:main()
    except Exception as exc:print('HTTPS update failed: '+str(exc),file=sys.stderr);sys.exit(1)
